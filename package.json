{
  "name": "hisab-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/db/prisma-generate.mjs",
    "build": "prisma generate && node scripts/db/prisma-migrate.mjs && next build",
    "build:sqlite": "prisma generate && node scripts/db/prisma-migrate.mjs && node scripts/db/prisma-sqlite-sync.mjs && next build",
    "db:seed": "npm rebuild better-sqlite3 && npx tsx prisma/seed.ts",
    "qa:seed": "npx tsx scripts/qa/qa-seed.mjs",
    "qa:verify": "node scripts/qa/qa-verify.mjs",
    "test:zatca": "npx --yes tsx --test tests/zatca/onboarding.test.ts",
    "zatca:sandbox": "npx tsx -r ./scripts/zatca/setup-server-only.cjs scripts/zatca/run-zatca-sandbox.mjs",
    "zatca:verify": "npx tsx -r ./scripts/zatca/setup-server-only.cjs scripts/zatca/zatca-phase7-verify.mjs",
    "supabase:migrate": "node scripts/db/apply-supabase-migrations.mjs",
    "supabase:seed": "node scripts/db/apply-supabase-seed.mjs",
    "supabase:apply": "node scripts/db/apply-supabase-migrations.mjs",
    "supabase:verify": "node scripts/db/verify-supabase-db.mjs",
    "migrate:export": "npx tsx scripts/db/migration/014_export_sqlite.ts",
    "migrate:id-map": "npx tsx scripts/db/migration/015_generate_id_map.ts",
    "migrate:import": "npx tsx scripts/db/migration/016_import_supabase.ts",
    "migrate:test-db": "npx tsx scripts/db/migration/018_test_db_connection.ts",
    "migrate:validate": "npx tsx scripts/db/migration/017_validate_migration.ts",
    "db:test-customer-vendor-write": "npx tsx -r ./scripts/zatca/setup-server-only.cjs scripts/db/test-customer-vendor-write.ts",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:sqlite-sync": "node scripts/db/prisma-sqlite-sync.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
