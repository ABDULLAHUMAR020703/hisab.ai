# hisab.ai Supabase-only environment
# Copy to `.env` for local development. Never commit real `.env` values.

# Supabase project API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# App/session secrets
APP_SECRET="replace-with-a-long-random-secret"

# ZATCA
ZATCA_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-long-random-secret"
ZATCA_MOCK_ONBOARDING=false
ZATCA_MOCK_SUBMISSION=false

# Optional ZATCA gateway override
# ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa"
