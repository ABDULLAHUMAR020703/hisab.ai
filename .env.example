# hisab.ai Supabase-only environment
# Copy to `.env` for local development. Never commit real `.env` values.

# Supabase project API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# App/session secrets
APP_SECRET="replace-with-a-long-random-secret"
INTEGRATION_TOKEN_ENCRYPTION_KEY="replace-with-a-dedicated-long-random-secret"

# QuickBooks Integration
# Explicit override. If unset: NODE_ENV=production → production, otherwise sandbox.
QB_CLIENT_ID="your-quickbooks-client-id"
QB_CLIENT_SECRET="your-quickbooks-client-secret"
QB_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
QB_ENVIRONMENT="sandbox"
# Production web + worker must use production Intuit app credentials and:
# QB_ENVIRONMENT="production"
# Temporary production freeze. Set true locally to restore the complete system.
ENABLE_QUICKBOOKS_CERTIFICATION=false

# ZATCA
ZATCA_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-long-random-secret"
ZATCA_MOCK_ONBOARDING=false
ZATCA_MOCK_SUBMISSION=false

# Optional ZATCA gateway override
# ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa"
CRON_SECRET=replace-with-a-long-random-secret

# Public legal pages
NEXT_PUBLIC_APP_URL="https://hisab.techdotglobal.com"
LEGAL_ENTITY_NAME="TechDotGlobal"
COMPANY_NAME="Hisab AI"
LEGAL_CONTACT_EMAIL="info@techdotglobal.com"
SUPPORT_EMAIL="info@techdotglobal.com"
PRIVACY_EMAIL="info@techdotglobal.com"
BUSINESS_ADDRESS="Street 63, I-14/3, Islamabad, Pakistan"
GOVERNING_LAW="Pakistan"
JURISDICTION="Pakistan"
LEGAL_EFFECTIVE_DATE="[TO BE SET ON APPROVAL]"
PRIMARY_DATA_REGION="Sydney, Australia"
