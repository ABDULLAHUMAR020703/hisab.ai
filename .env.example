# =============================================================================
# hisab.ai environment variables
# Copy to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# --- Runtime mode --------------------------------------------------------------

# Supabase is the default runtime. Set false only for Prisma/SQLite rollback.
USE_SUPABASE=true

# Vercel builds skip Prisma migrations by default; run migrations separately.
RUN_PRISMA_MIGRATE=false

# Shadow-read Supabase while Prisma remains primary (Phase D4 parity testing)
DB_PARITY_CHECK=false

# Dual-write Supabase while Prisma remains primary (Phase D5 parity testing)
DUAL_WRITE=false

# --- Prisma/SQLite rollback only ----------------------------------------------

# Kept only for rollback and legacy scripts until Prisma is removed in Phase E.
DATABASE_URL="file:./prisma/dev.db"

# --- Supabase Postgres (migration scripts) -------------------------------------
# Dashboard → Settings → Database → Connection string → URI
# Use your database password (not anon/service keys).

SUPABASE_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# --- Supabase API (auth user creation during migrate:import) -------------------

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Phase C migration -------------------------------------------------------

MIGRATION_USER_PASSWORD="your-migration-password"

# --- ZATCA -------------------------------------------------------------------

ZATCA_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-long-random-secret"
ZATCA_MOCK_ONBOARDING=false
ZATCA_MOCK_SUBMISSION=false

# Optional override (default: https://gw-fatoora.zatca.gov.sa)
# ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa"

# --- Auth (legacy custom sessions until Supabase Auth cutover) ---------------

NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
